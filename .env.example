# --- Trakt list -------------------------------------------------------------
# The list is created automatically if it does not exist yet.
TRAKT_LIST_NAME=Cinema Zed
# private | friends | public
TRAKT_LIST_PRIVACY=private

# --- Cinema Zed -------------------------------------------------------------
CINEMA_ZED_URL=https://www.cinemazed.be/nl/alle-films-leuven

# --- Scheduling -------------------------------------------------------------
# Daily run time (24h clock, in the TZ below).
RUN_AT=08:00
TZ=Europe/Brussels

# Set to 1 to run a single sync and exit (handy with an external scheduler).
RUN_ONCE=0

# Fetch each film's detail page to read its release year (improves matching).
FETCH_FILM_DETAILS=1
